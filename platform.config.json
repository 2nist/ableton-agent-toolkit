{
  "$schema": "./docs/platform.config.schema.json",
  "sharedPackages": [
    { "name": "@music-theory/core", "path": "packages/music-theory" },
    { "name": "@music-theory/song-structure", "path": "packages/song-structure" },
    { "name": "@platform/progression-engine", "path": "packages/progression-engine" },
    { "name": "@platform/ui-kit", "path": "packages/ui-kit" },
    { "name": "@platform/test-harness", "path": "packages/test-harness" },
    { "name": "@platform/osc-bridge", "path": "packages/osc-bridge" },
    { "name": "@groove/capture", "path": "packages/groove-capture" },
    { "name": "@daw/virtual-reaper", "path": "packages/virtual-reaper" },
    { "name": "@daw/routing-matrix", "path": "packages/routing-matrix" },
    { "name": "@hardware/controller-bridge", "path": "packages/controller-bridge" },
    { "name": "@hardware/step-sequencer", "path": "packages/step-sequencer" },
    { "name": "@drum/rack-kit", "path": "packages/drum-rack-kit" }
  ],
  "templates": [
    {
      "id": "extension-basic",
      "targetDir": "extensions",
      "path": "templates/extension-basic/templates",
      "description": "Ableton Extension, copied verbatim from the vendored ableton-create-extension tarball. The --ui flag on `platform create extension` toggles the modal-dialog variant — there is no separate template for it, matching the official tool's own single-template-set-with-conditionals design."
    },
    {
      "id": "m4l-device-basic",
      "targetDir": "devices",
      "path": "templates/m4l-device-basic",
      "description": "Max for Live device with a jweb-hosted UI, derived from the one hand-authored reference.amxd. Working — see docs/m4l-scaffolding-risk.md for format details and the one remaining manual verification step."
    }
  ]
}
