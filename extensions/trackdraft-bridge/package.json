{
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "build:production": "tsc --noEmit && tsx build.ts --production",
    "start": "tsx build.ts && extensions-cli run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build:production && extensions-cli package",
    "sync-blueprints": "bash scripts/sync-blueprints.sh"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:../../vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz",
    "@drum/library": "0.1.0",
    "@music-theory/core": "0.1.0",
    "@music-theory/song-blueprint": "0.1.0",
    "@music-theory/song-structure": "0.1.0"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:../../vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@platform/test-harness": "0.0.0",
    "@types/node": "^25.0.10",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
