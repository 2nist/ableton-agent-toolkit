{
  "name": "progression-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/extension.js",
  "description": "Progression Studio — data-driven chord progression builder (webview modal) powered by @platform/progression-engine. Browse/build/edit chord qualities + durations, tension-colored, with corpus-ranked next-chord and path suggestions.",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "start": "tsx build.ts && extensions-cli run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:../../vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz",
    "@music-theory/core": "0.1.0",
    "@platform/progression-engine": "0.1.0"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:../../vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@platform/test-harness": "0.0.0",
    "@types/node": "^25.0.10",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
