{
  "name": "ableton-agent-toolkit",
  "private": true,
  "version": "0.0.0",
  "description": "Agentic tooling platform for Ableton Live: Extensions SDK tools and Max for Live devices sharing one music-theory backend and one UI kit.",
  "workspaces": [
    "packages/*",
    "extensions/*",
    "devices/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm run test",
    "dev": "npm run dev --workspace=apps/trackdraft",
    "cli": "node packages/cli/dist/cli.js",
    "bridge": "npm run start -w packages/osc-bridge",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks || true",
    "plugin:build": "cmake -B plugins/trackdraft/build -DCMAKE_BUILD_TYPE=Release && cmake --build plugins/trackdraft/build -j8",
    "plugin:test": "cmake --build plugins/trackdraft/build --target TrackDraftTests && plugins/trackdraft/build/TrackDraftTests_artefacts/Release/TrackDraftTests"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-xml-parser": "^5.10.1",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.71.2"
  }
}
