{
  "name": "@platform/progression-engine",
  "version": "0.1.0",
  "description": "Data-driven chord progression engine: Markov transition model over a progression corpus (suggestNext, rankPaths), plus a hybrid functional+empirical diatonic-tension model with color mapping. Backs the Progression Studio (Chord Assistant v2).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:model": "tsx scripts/build-model.ts",
    "build:melody": "python3 scripts/extract_melody_model.py",
    "build:songs": "python3 scripts/extract_song_sections.py"
  },
  "dependencies": {
    "@music-theory/core": "0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
