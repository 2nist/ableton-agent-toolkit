{
  "name": "@platform/osc-bridge",
  "version": "0.1.0",
  "description": "Relays Ableton Live's playhead position and play state (via AbletonOSC — the Extensions SDK has no access to either) to WebSocket clients as JSON.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "osc": "^2.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
