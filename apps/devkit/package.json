    "build": "npm run prebuild && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@devkit/puck-engine": "0.1.0",
    "@measured/puck": "^0.20.2",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "reactflow": "^11.11.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.8"
  }
}
