{
  "name": "devkit",
  "private": true,
  "version": "0.1.0",
  "description": "Unified dev dashboard: component dependency graph, live preview, and CSS playground for trackdraft",
  "type": "module",
  "scripts": {
    "generate": "tsx scripts/generate-registry.ts",
    "predev": "npm run generate",
    "dev": "npm run predev && vite",
