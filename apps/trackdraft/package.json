{
  "name": "trackdraft",
  "private": true,
  "version": "0.1.0",
  "description": "TrackDraft \u2014 songwriting productivity app (rebuild). Structure, harmony, and lyrics authoring for concept-album blueprint data, built on @music-theory/core and @music-theory/song-structure.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "npm run generate-puck",
    "dev": "npm run predev && vite",
    "build": "npm run predev && tsc --noEmit && vite build",
    "prebuild": "npm run predev",
    "generate-puck": "tsx scripts/generate-puck.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest-lalo-chezia.ts",
    "catalog:ingest:beatles": "tsx scripts/ingest-beatles-catalog.ts",
    "catalog:ingest:mcgill": "tsx scripts/ingest-mcgill-catalog.ts",
    "catalog:ingest:rock": "tsx scripts/ingest-rock-corpus-catalog.ts",
    "catalog:ingest:lalo": "tsx scripts/ingest-lalo-chezia.ts",
    "catalog:repair": "tsx scripts/repair-catalog.ts",
    "catalog:triage": "tsx scripts/triage-catalog.ts",
    "catalog:audit": "tsx scripts/audit-catalog.ts",
    "catalog:manifest": "tsx scripts/build-catalog-manifest.ts",
    "catalog:pack:starter": "tsx scripts/pack-starter-catalog.ts",
    "start": "bash start-all.sh",
    "electron": "npm run build && electron .",
    "electron:dev": "TRACKDRAFT_DEV_URL=http://localhost:5183 electron .",
    "bundle:catalog": "tsx scripts/bundle-catalog.ts",
    "electron:test-build": "npm run build && npm run catalog:pack:starter -- --profile internal --acknowledge-restricted --force --source beatles && npm run bundle:catalog -- --from scripts/output/catalog-internal --allow-internal",
    "electron:test": "npm run electron:test-build && electron .",
    "package:mac": "node scripts/package-mac.mjs",
    "package:mac:arm64": "node scripts/package-mac.mjs --arch arm64",
    "icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "@devkit/puck-engine": "0.1.0",
    "@drum/library": "0.1.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@measured/puck": "^0.20.2",
    "@music-theory/core": "0.1.0",
    "@music-theory/song-blueprint": "0.1.0",
    "@music-theory/song-structure": "0.1.0",
    "@music-theory/song-taxonomy": "0.1.0",
    "@platform/progression-engine": "0.1.0",
    "@platform/ui-kit": "0.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "syllable": "^5.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "mammoth": "^1.12.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^5.0.8",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5",
    "electron": "^33.0.0"
  }
}
