{
  "name": "trackdraft",
  "private": true,
  "version": "0.1.0",
  "description": "TrackDraft — songwriting productivity app (rebuild). Structure, harmony, and lyrics authoring for concept-album blueprint data, built on @music-theory/core and @music-theory/song-structure.",
  "type": "module",
  "scripts": {
    "predev": "npm run generate-puck",
    "dev": "npm run predev && vite",
    "build": "npm run predev && tsc --noEmit && vite build",
    "prebuild": "npm run predev",
    "generate-puck": "tsx scripts/generate-puck.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest-lalo-chezia.ts"
  },
  "dependencies": {
    "@devkit/puck-engine": "0.1.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@measured/puck": "^0.20.2",
    "@music-theory/core": "0.1.0",
    "@music-theory/song-blueprint": "0.1.0",
    "@music-theory/song-structure": "0.1.0",
    "@music-theory/song-taxonomy": "0.1.0",
    "@platform/ui-kit": "0.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "smplr": "^1.0.0",
    "soundfont2": "^0.5.0",
    "syllable": "^5.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "mammoth": "^1.12.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^5.0.8",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  }
}
